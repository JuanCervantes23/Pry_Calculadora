<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Vista.vistaResultados">

    <TextView
        android:id="@+id/vista2txtTotalKw"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="178dp"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="176dp"
        android:text="Salida: Kw Consumidos"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.492"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/vista2txtPagoRecibo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="96dp"
        android:text="Salida: Recibo de pago"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="@+id/vista2txtTotalKw"
        app:layout_constraintHorizontal_bias="0.181"
        app:layout_constraintStart_toStartOf="@+id/vista2txtTotalKw"
        app:layout_constraintTop_toBottomOf="@+id/vista2txtTotalKw" />
</androidx.constraintlayout.widget.ConstraintLayout>